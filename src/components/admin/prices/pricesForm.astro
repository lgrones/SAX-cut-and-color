---
import { getFirestore } from "firebase-admin/firestore";
import { app } from "../../../firebase/server";
import Card from "../../card/card.astro";
import type { Price } from "../../../types";
import { PricesInput } from "./pricesInput";

interface PricesWithId extends Price {
  id: string;
}

const db = getFirestore(app);
const ref = db.collection("prices");
const snapshot = await ref.get();
const prices = snapshot.docs.map(
  (doc) => ({ id: doc.id, ...doc.data() }) as PricesWithId
);
---

<Card title="Preise" id="prices">
  <form method="post" action="/api/prices">
    <PricesInput prices={prices} client:load />

    <button
      type="submit"
      class="mt-8 text-sax-dark bg-sax-tan hover:bg-sax-tan/90 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center"
    >
      Speichern
    </button>
  </form>
</Card>
