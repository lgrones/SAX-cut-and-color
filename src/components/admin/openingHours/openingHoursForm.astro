---
import { getFirestore } from "firebase-admin/firestore";
import { app } from "../../../firebase/server";
import Card from "../../card/card.astro";
import type { OpeningHours } from "../../../types/openingHours";

interface OpeningHoursWithId extends OpeningHours {
  id: string;
}

const db = getFirestore(app);
const ref = db.collection("openingHours");
const snapshot = await ref.get();
const openingHours = snapshot.docs
  .map((doc) => ({ id: doc.id, ...doc.data() }) as OpeningHoursWithId)
  .toSorted((a, b) => a.index - b.index);
---

<Card title="Zeiten" id="times">
  <form method="post" action="/api/openingHours" autocomplete="off">
    <div class="flex flex-wrap gap-x-10 gap-y-6">
      {
        openingHours.map((openingHour) => (
          <div class="flex flex-col gap-y-2" id={openingHour.id}>
            <p class="block text-xl text-sax-tan">{openingHour.day}</p>

            <label
              for={openingHour.day + "timeAmStart"}
              class="block  text-sax-tan"
            >
              Vormittag
            </label>

            <div class="flex gap-2 items-center text-white">
              <input
                type="time"
                name={openingHour.id + "-timeAmStart"}
                id={openingHour.id + "-timeAmStart"}
                value={openingHour.timeAmStart}
                disabled={openingHour.closed}
                required={!openingHour.closed}
                class="bg-stone-800 border-2 border-stone-600 rounded-lg focus:border-sax-tan focus:ring-0 block w-full p-1.5 disabled:opacity-40"
              />
              -
              <input
                type="time"
                name={openingHour.id + "-timeAmEnd"}
                id={openingHour.id + "-timeAmEnd"}
                value={openingHour.timeAmEnd}
                disabled={openingHour.closed}
                required={!openingHour.closed}
                class="bg-stone-800 border-2 border-stone-600 rounded-lg focus:border-sax-tan focus:ring-0 block w-full p-1.5 disabled:opacity-40"
              />
            </div>

            <label
              for={openingHour.id + "timePmStart"}
              class="block  text-sax-tan"
            >
              Nachmittag
            </label>

            <div class="flex gap-2 items-center text-white">
              <input
                type="time"
                name={openingHour.id + "-timePmStart"}
                id={openingHour.id + "-timePmStart"}
                value={openingHour.timePmStart}
                disabled={openingHour.closed}
                class="bg-stone-800 border-2 border-stone-600 rounded-lg focus:border-sax-tan focus:ring-0 block w-full p-1.5 disabled:opacity-40"
              />
              -
              <input
                type="time"
                name={openingHour.id + "-timePmEnd"}
                id={openingHour.id + "-timePmEnd"}
                value={openingHour.timePmEnd}
                disabled={openingHour.closed}
                class="bg-stone-800 border-2 border-stone-600 rounded-lg focus:border-sax-tan focus:ring-0 block w-full p-1.5 disabled:opacity-40"
              />
            </div>

            <div class="flex items-center mb-4">
              <input
                name={openingHour.id + "-closed"}
                id={openingHour.id + "-closed"}
                type="checkbox"
                checked={openingHour.closed}
                class="w-4 h-4 text-sax-tan rounded bg-stone-800 border-stone-600 focus:border-sax-tan focus:ring-0 focus:ring-offset-0"
              />
              <label for={openingHour.id + "-closed"} class="ms-2">
                Geschlossen
              </label>
            </div>
          </div>
        ))
      }
    </div>

    <button
      type="submit"
      class="mt-8 text-sax-dark bg-sax-tan hover:bg-sax-tan/90 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center"
    >
      Speichern
    </button>
  </form>
</Card>
<script>
  const inputs = document.querySelectorAll(
    "#times input"
  ) as NodeListOf<HTMLInputElement>;
  const textInputs = [...inputs].filter((x) => x.type !== "checkbox");
  const checkboxes = [...inputs].filter((x) => x.type === "checkbox");

  checkboxes.forEach((x) =>
    x.addEventListener("change", (e) => {
      if (!e.target) return;

      // @ts-ignore
      if (e.target.checked)
        textInputs
          // @ts-ignore
          .filter((y) => y.id.startsWith(e.target.id.split("-")[0]))
          .forEach((y) => (y.disabled = true));
      else
        textInputs
          // @ts-ignore
          .filter((y) => y.id.startsWith(e.target.id.split("-")[0]))
          .forEach((y) => {
            y.disabled = false;
            y.required = y.id.includes("timeAm");
          });
    })
  );
</script>
