---
interface Props {
  title: string;
  priceMin: number;
  priceMax: number;
}

const { title, priceMin, priceMax } = Astro.props;

const price = Intl.NumberFormat("de-DE", {
  style: "currency",
  currency: "EUR",
  currencyDisplay: "code",
  minimumFractionDigits: 0,
})
  .formatRange(priceMin, priceMax)
  .replace("–", " - ");
---

<div class="flex justify-between gap-x-24 text-nowrap">
  <div class="font-medium tracking-wide">
    {title}
  </div>

  {price}
</div>
