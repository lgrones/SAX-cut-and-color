---
interface Props {
  title: string;
  salon?: boolean;
  priceMin?: number;
  priceMax?: number;
}

const { title, priceMin, priceMax, salon } = Astro.props;

const price =
  salon || !priceMin
    ? "Absprache im Salon"
    : Intl.NumberFormat("de-DE", {
        style: "currency",
        currency: "EUR",
        currencyDisplay: "code",
      })
        .formatRange(priceMin, priceMax ?? priceMin)
        .replace("–", " - ")
        .replace("≈", "")
        .replaceAll(",00", "");
---

<div class="font-medium tracking-wide whitespace-nowrap">
  {title}
</div>

<div class="text-right justify-self-end">
  {price}
</div>
