---
interface Props {
  title: string;
  priceMin: number;
  priceMax: number;
}

const { title, priceMin, priceMax } = Astro.props;

const price = Intl.NumberFormat("de-DE", {
  style: "currency",
  currency: "EUR",
  currencyDisplay: "code",
  minimumFractionDigits: 0,
})
  .formatRange(priceMin, priceMax)
  .replace("–", " - ");
---

<div class="font-medium tracking-wide whitespace-nowrap">
  {title}
</div>

<div class="whitespace-nowrap justify-self-end sm:justify-self-auto">
  {price}
</div>
