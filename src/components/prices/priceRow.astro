---
import type { Price } from '../../types';

type Props = Price['prices'][number];

const { title, priceMin, priceMax, salon } = Astro.props;

const formatter = new Intl.NumberFormat('de-DE', {
  style: 'currency',
  currency: 'EUR',
  currencyDisplay: 'code',
  trailingZeroDisplay: 'stripIfInteger',
});

const formatPrice = (min: number, max?: number) =>
  max && max !== min
    ? formatter.formatRange(min, max).replace('–', ' - ')
    : formatter.format(min);

const price =
  salon || !priceMin ? 'Absprache im Salon' : formatPrice(priceMin, priceMax);
---

<div class:list={['title', { nowrap: title.length < 25 }]}>{title}</div>

<div class="price">{price}</div>

<style>
  .title {
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  .nowrap {
    white-space: nowrap;
  }

  .price {
    justify-self: end;
    text-align: right;
  }
</style>
