---
import Card from '../card/card.astro';
import { getCollection } from '../../firebase/server';
import PriceRow from './priceRow.astro';
import type { Price } from '../../types';

const categories = await getCollection<Price>('prices');

// Always fetch fresh data so admin edits show up on the next page view
Astro.response.headers.set('Cache-Control', 'no-store');
---

<div class="staggered-grid">
  {categories.map(({ mainTitle, prices }) => (
    <Card title={mainTitle} subTitle="Preise">
      <div class="rows">
        {prices.map(price => (
          <PriceRow {...price} />
        ))}
      </div>
    </Card>
  ))}
</div>

<style>
  .rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 3.5rem;

    @media (min-width: 768px) {
      column-gap: 6rem;
    }
  }
</style>
