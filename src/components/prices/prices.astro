---
import Card from "../card/card.astro";
import PriceRow from "./priceRow.astro";
import prices from "./prices.json";

const getGridPos = (index: number) => {
  if (index % 4 === 0) return "col-end-7";

  if (index % 3 == 0) return "col-start-2";

  if (index % 2 == 0) return "col-end-6";

  return "col-start-1";
};
---

<div id="prices" class="grid grid-cols-6 gap-16">
  {
    prices.map(({ title, prices }, i) => (
      <div class={`col-span-2 ${getGridPos(i + 1)}`}>
        <Card title={title} id={title}>
          <div class="flex flex-col gap-y-2">
            {prices.map(({ title: priceTitle, priceMin, priceMax }) => (
              <PriceRow
                title={priceTitle}
                priceMin={priceMin}
                priceMax={priceMax}
              />
            ))}
          </div>
        </Card>
      </div>
    ))
  }
</div>
