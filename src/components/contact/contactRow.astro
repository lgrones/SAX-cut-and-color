---
interface Props {
  title: string;
  href: string;
  label: string;
  external?: boolean;
}

const { title, href, label, external } = Astro.props;
---

<div class="row">
  <div class="title">{title}</div>
  <a href={href} target={external ? '_blank' : undefined} class="text-link">
    {label}
  </a>
</div>

<style>
  .row {
    display: flex;
    justify-content: space-between;
    column-gap: 2.5rem;
    text-wrap: nowrap;

    @media (min-width: 768px) {
      column-gap: 6rem;
    }
  }

  .title {
    font-weight: 500;
    letter-spacing: 0.025em;
  }
</style>
