---
interface Props {
  title: string;
  href: string;
  value: string;
  external?: boolean;
}

const { title, href, value, external } = Astro.props;
---

<div class="flex justify-between gap-x-24 text-nowrap">
  <div class="font-medium tracking-wide">{title}</div>
  <a
    href={href}
    target={external ? "_blank" : undefined}
    class="underline underline-offset-4 decoration-1"
  >
    {value}
  </a>
</div>
