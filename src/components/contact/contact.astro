---
import { Image } from "astro:assets";
import Card from "../card/card.astro";
import map from "../../assets/map.png";
import ContactRow from "./contactRow.astro";
---

<Card title="Kontakt" id="contact">
  <div class="flex flex-col gap-y-6 relative xl:pr-72 pb-[240px] xl:pb-0 z-20">
    <ContactRow
      title="Telefon"
      href="tel:+436644213849"
      value="+43 664 421 384 9"
    />

    <ContactRow
      title="E-Mail"
      href="mailto:petra.zangerl@chello.at"
      value="petra.zangerl@chello.at"
    />

    <ContactRow
      title="Adresse"
      href="https://maps.app.goo.gl/xGp8EXpDn3pVrubA6"
      external
      value="Landstraße 46, 6911 Lochau, Österreich"
    />
  </div>

  <div slot="image" class="absolute bottom-0 xl:bottom-auto xl:top-0 right-0">
    <Image
      src={map}
      alt="Karte"
      loading="eager"
      class="rounded w-auto h-[208px]"
    />

    <a
      class="absolute right-3 bottom-3 z-20 underline underline-offset-4 decoration-1 [text-shadow:black_0.1em_0.1em_0.2em]"
      href="https://maps.app.goo.gl/xGp8EXpDn3pVrubA6"
      target="_blank">Zur Karte</a
    >
  </div>
</Card>
