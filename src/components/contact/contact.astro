---
import { Image } from "astro:assets";
import Card from "../card/card.astro";
import map from "../../assets/map.png";
import ContactRow from "./contactRow.astro";
---

<Card title="Kontakt" id="contact">
  <div class="rows">
    <ContactRow
      title="Telefon"
      href="tel:+436644213849"
      value="+43 664 421 384 9"
    />

    <ContactRow
      title="E-Mail"
      href="mailto:petra.zangerl@chello.at"
      value="petra.zangerl@chello.at"
    />

    <ContactRow
      title="Adresse"
      href="https://maps.app.goo.gl/xGp8EXpDn3pVrubA6"
      external
      value="Landstraße 46, 6911 Lochau"
    />
  </div>

  <div slot="image" class="map">
    <Image
      src={map}
      alt="Karte"
      loading="eager"
      class="map-image"
    />

    <a
      class="map-link text-link"
      href="https://maps.app.goo.gl/xGp8EXpDn3pVrubA6"
      target="_blank">Zur Karte</a
    >
  </div>
</Card>

<style>
  .rows {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    row-gap: 1.5rem;
    padding-bottom: 240px;

    @media (min-width: 1280px) {
      padding-right: 18rem;
      padding-bottom: 0;
    }
  }

  .map {
    position: absolute;
    right: 0;
    bottom: 0;

    @media (min-width: 1280px) {
      top: 0;
      bottom: auto;
    }
  }

  .map-image {
    width: auto;
    height: 208px;
    border-radius: 0.25rem;
  }

  .map-link {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 20;
    text-shadow: black 0.1em 0.1em 0.2em;
  }
</style>
