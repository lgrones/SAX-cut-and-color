---
import { Image } from 'astro:assets';
import Card from '../card/card.astro';
import map from '../../assets/map.png';
import ContactRow from './contactRow.astro';
import { contact } from '../../data/contact';
---

<Card title="Kontakt" id="contact">
  <div class="rows">
    <ContactRow title="Telefon" {...contact.phone} />
    <ContactRow title="E-Mail" {...contact.email} />
    <ContactRow title="Adresse" {...contact.address} external />
  </div>

  <div slot="image" class="map">
    <Image src={map} alt="Karte" loading="eager" class="map-image" />

    <a class="map-link text-link" href={contact.address.href} target="_blank">
      Zur Karte
    </a>
  </div>
</Card>

<style>
  .rows {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    row-gap: 1.5rem;
    padding-bottom: 240px;

    @media (min-width: 1280px) {
      padding-right: 18rem;
      padding-bottom: 0;
    }
  }

  .map {
    position: absolute;
    right: 0;
    bottom: 0;

    @media (min-width: 1280px) {
      top: 0;
      bottom: auto;
    }
  }

  .map-image {
    width: auto;
    height: 208px;
    border-radius: 0.25rem;
  }

  .map-link {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 20;
    text-shadow: black 0.1em 0.1em 0.2em;
  }
</style>
