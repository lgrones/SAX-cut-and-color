---
interface Props {
  title: string;
  subTitle?: string;
  id?: string;
}

const { title, subTitle, id } = Astro.props;
---

<div id={id} class="section">
  <div class="card">
    <div>
      <div class="eyebrow">
        <p>{subTitle}</p>
        <div class="rule"></div>
      </div>

      <h2>{title}</h2>

      <slot />
    </div>

    <slot name="image" />
  </div>
</div>

<style>
  .card {
    position: relative;
  }

  .eyebrow {
    width: 7rem;

    & p {
      padding-bottom: 0.25rem;
      font-family: var(--font-cormorant);
      text-align: right;
    }
  }

  .rule {
    height: 1px;
    background-color: var(--sax-tan);
  }

  h2 {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-cormorant);
    font-size: 2.25rem;
    line-height: 2.5rem;

    @media (min-width: 768px) {
      font-size: 3rem;
      line-height: 1;
    }
  }
</style>
