---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';

const links = [
  { name: 'Zeiten', id: 'opening-hours' },
  { name: 'Kontakt', id: 'contact' },
  { name: 'Preise', id: 'prices' },
  { name: 'Angebote', id: 'offers' },
  { name: 'Salon', id: 'salon' },
];
---

<header>
  <nav>
    <div class="bar">
      <a href="/" class="logo">
        <Image src={logo} alt="SAX Logo" loading="eager" class="logo-image" />
      </a>

      <button
        id="burger"
        type="button"
        class="burger"
        aria-controls="navbar-default"
        aria-expanded="false"
      >
        <span class="sr-only">Navigation öffnen</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          ></path>
        </svg>
      </button>

      <div class="menu" id="navbar-default">
        <ul>
          {links.map(({ name, id }) => (
            <li>
              <a href={`/#${id}`} class="link">
                {name}
              </a>
            </li>
          ))}
        </ul>

        <div id="overlay" class="overlay"></div>
      </div>
    </div>
  </nav>
</header>

<style>
  nav {
    position: fixed;
    top: 0;
    inset-inline-start: 0;
    z-index: 20;
    width: 100%;
    height: var(--header-height);
    background-color: var(--sax-dark);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    max-width: 1280px;
    margin-inline: auto;
    padding: 1rem 1.5rem;
    background-color: var(--sax-dark);
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo-image {
    width: 120px;
  }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--sax-tan);
    border-radius: 0.5rem;
    scale: 1.25;

    &:hover {
      color: var(--sax-dark);
      background-color: var(--sax-tan);
    }

    & svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .menu {
    display: none;
    position: relative;
    width: 100%;

    &.open {
      display: block;
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    row-gap: 0.5rem;
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  .link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 1.25rem;
    line-height: 1.75rem;
    color: var(--sax-tan);
    border-radius: 0.25rem;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition-property: color, background-color, text-decoration-color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;

    &:hover {
      color: var(--sax-dark);
      background-color: var(--sax-tan);
    }

    @media (min-width: 768px) {
      padding: 0;

      &:hover {
        color: var(--sax-tan);
        background-color: transparent;
        text-decoration-color: var(--sax-tan);
      }
    }
  }

  .overlay {
    position: absolute;
    width: 100%;
    height: 100dvh;
    background-color: rgb(22 21 22 / 60%);
  }

  @media (min-width: 768px) {
    .logo-mobile,
    .burger,
    .link {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 1.25rem;
      line-height: 1.75rem;
      color: var(--sax-tan);
      border-radius: 0.25rem;
      text-decoration-line: underline;
      text-decoration-color: transparent;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
      transition-property: color, background-color, text-decoration-color;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      transition-duration: 300ms;

      &:hover {
        color: var(--sax-dark);
        background-color: var(--sax-tan);
      }

      @media (min-width: 768px) {
        padding: 0;

        &:hover {
          color: var(--sax-tan);
          background-color: transparent;
          text-decoration-color: var(--sax-tan);
        }
      }
    }

    .overlay {
      display: none;
    }

    .logo-desktop {
      display: flex;
    }

    .logo-image {
      width: 150px;
    }

    .menu {
      display: block;
      width: auto;
    }

    ul {
      flex-direction: row;
      column-gap: 3rem;
      margin-top: 0;
    }
  }
</style>

<script>
  const menu = document.getElementById('navbar-default');
  const burger = document.getElementById('burger');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
  };

  burger?.addEventListener('click', () =>
    setOpen(!menu?.classList.contains('open')),
  );

  document
    .querySelectorAll('header a, #overlay')
    .forEach(x => x.addEventListener('click', () => setOpen(false)));
</script>
