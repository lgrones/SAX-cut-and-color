---
interface Props {
  name: string;
  link: string;
}

const { name, link } = Astro.props;
---

<a
  href={`/#${link}`}
  class={`block py-2 px-3 rounded md:p-0 dark:text-gray-100 md:dark:hover:text-tan-300 
  dark:hover:bg-tan-300 dark:hover:text-zinc-950 md:dark:hover:bg-transparent`}
  >{name}</a
>
