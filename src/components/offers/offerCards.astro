---
import Card from '../card/card.astro';
import { getCollection } from '../../firebase/server';
import type { Offer } from '../../types';

const offers = await getCollection<Offer>('offers');
---

<div class="staggered-grid">
  {offers.map(({ title, text }) => (
    <Card title={title} subTitle="Angebot">
      <p>{text}</p>
    </Card>
  ))}
</div>
