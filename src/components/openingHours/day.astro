---
import type { OpeningHours } from '../../types';

type Props = OpeningHours;

const { day, timeAmStart, timeAmEnd, timePmStart, timePmEnd, closed } =
  Astro.props;

const ranges = [
  [timeAmStart, timeAmEnd],
  [timePmStart, timePmEnd],
].filter(([start, end]) => start && end);
---

{!closed && ranges.length > 0 && (
  <div class="day">
    <div class="name">{day}</div>
    <div>
      {ranges.map(([start, end]) => (
        <div>
          {start} - {end} Uhr
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .day {
    display: flex;
    justify-content: space-between;
    column-gap: 3.5rem;
    text-wrap: nowrap;

    @media (min-width: 640px) {
      column-gap: 6rem;
    }
  }

  .name {
    font-weight: 500;
    letter-spacing: 0.025em;
  }
</style>
