---
interface Props {
  day: string;
  timeAmStart?: string;
  timeAmEnd?: string;
  timePmStart?: string;
  timePmEnd?: string;
}

const { day, timeAmStart, timeAmEnd, timePmStart, timePmEnd } = Astro.props;
const hasAmTimes = !!timeAmStart && !!timeAmEnd;
const hasPmTimes = !!timePmStart && !!timePmEnd;
const isClosed = !hasAmTimes && !hasPmTimes;
---

{
  isClosed ? null : (
    <div class="flex justify-between gap-x-24 text-nowrap">
      <div class="font-medium tracking-wide">{day}</div>
      <div>
        {timeAmStart}
        {timeAmEnd && ` - ${timeAmEnd}`} Uhr
        {hasPmTimes && (
          <>
            {hasAmTimes && <br />}
            {timePmStart}
            {timePmEnd && ` - ${timePmEnd}`} Uhr
          </>
        )}
      </div>
    </div>
  )
}
