---
interface Props {
  day: string;
  timeAmStart: string;
  timeAmEnd: string;
  timePmStart?: string;
  timePmEnd?: string;
}

const { day, timeAmStart, timeAmEnd, timePmStart, timePmEnd } = Astro.props;
const hasEndTimes = !!timePmStart && !!timePmEnd;
---

<div>
  <div class="text-xl mb-1">{day}</div>
  <div class="text-lg text-justify w-auto">
    {timeAmStart} - {timeAmEnd}{
      hasEndTimes && (
        <>
          <br />
          {timePmStart} - {timePmEnd}
        </>
      )
    }
  </div>
</div>
