---
import type { OpeningHours } from "../../types";

type Props = OpeningHours;

const { day, timeAmStart, timeAmEnd, timePmStart, timePmEnd, closed } =
  Astro.props;
const hasAmTimes = !!timeAmStart && !!timeAmEnd;
const hasPmTimes = !!timePmStart && !!timePmEnd;
const isClosed = closed || (!hasAmTimes && !hasPmTimes);
---

{
  isClosed ? null : (
    <div class="day">
      <div class="name">{day}</div>
      <div>
        {timeAmStart}
        {timeAmEnd && ` - ${timeAmEnd}`} Uhr
        {hasPmTimes && (
          <>
            {hasAmTimes && <br />}
            {timePmStart}
            {timePmEnd && ` - ${timePmEnd}`} Uhr
          </>
        )}
      </div>
    </div>
  )
}

<style>
  .day {
    display: flex;
    justify-content: space-between;
    column-gap: 3.5rem;
    text-wrap: nowrap;

    @media (min-width: 640px) {
      column-gap: 6rem;
    }
  }

  .name {
    font-weight: 500;
    letter-spacing: 0.025em;
  }
</style>
