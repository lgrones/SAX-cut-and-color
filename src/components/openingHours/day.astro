---
interface Props {
  day: string;
  timeAmStart?: string;
  timeAmEnd?: string;
  timePmStart?: string;
  timePmEnd?: string;
}

const { day, timeAmStart, timeAmEnd, timePmStart, timePmEnd } = Astro.props;
const hasAmTimes = !!timeAmStart && !!timeAmEnd;
const hasPmTimes = !!timePmStart && !!timePmEnd;
const isClosed = !hasAmTimes && !hasPmTimes;
---

<div>
  <div class="text-xl mb-1">{day}</div>
  <div class="text-lg text-justify w-auto">
    {
      isClosed ? (
        "Geschlossen"
      ) : (
        <>
          {timeAmStart}
          {timeAmEnd && ` - ${timeAmEnd}`}
          {hasPmTimes && (
            <>
              {hasAmTimes && <br />}
              {timePmStart}
              {timePmEnd && ` - ${timePmEnd}`}
            </>
          )}
        </>
      )
    }
  </div>
</div>
