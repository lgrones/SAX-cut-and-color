---
import Card from "../card/card.astro";
import Day from "./day.astro";
---

<Card title="Zeiten" id="opening-hours">
  <div class="flex flex-wrap gap-x-20 gap-y-6">
    <Day day="Montag" timesAm="Geschlossen" />
    <Day day="Dienstag" timesAm="09:00 - 12:00" timesPm="14:00 - 19:00" />
    <Day day="Mittwoch" timesAm="09:00 - 12:00" timesPm="14:00 - 19:00" />
    <Day day="Donnerstag" timesAm="09:00 - 12:00" timesPm="14:00 - 19:00" />
    <Day day="Freitag" timesAm="09:00 - 15:00" />
    <Day day="Samstag" timesAm="Geschlossen" />
    <Day day="Sonntag" timesAm="Geschlossen" />
  </div>
</Card>
