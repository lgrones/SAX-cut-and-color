---
import { getCollection } from '../../firebase/server';
import Card from '../card/card.astro';
import Day from './day.astro';
import type { OpeningHours } from '../../types';

const openingHours = await getCollection<OpeningHours>('openingHours');
---

<Card title="Zeiten" id="opening-hours">
  <div class="days">
    {openingHours.map(openingHour => (
      <Day {...openingHour} />
    ))}
  </div>
</Card>

<style>
  .days {
    display: flex;
    flex-direction: column;
    row-gap: 1rem;
  }
</style>
