---
import Card from "../card/card.astro";
import salon2 from "../../assets/salon/salon2.jpeg";
import salon3 from "../../assets/salon/salon3.jpeg";
import salon4 from "../../assets/salon/salon4.jpeg";
import salon5 from "../../assets/salon/salon5.jpg";
import salon7 from "../../assets/salon/salon7.jpeg";
import salon8 from "../../assets/salon/salon8.jpeg";
import { Image } from "astro:assets";
---

<Card title="Salon" id="salon">
  <div class="flex flex-wrap gap-4">
    <div
      class="sm:flex-[calc(50%_-_2rem)] sm:max-w-[calc(50%_-_2rem)] flex-[100%] max-w-[100%]"
    >
      <Image
        src={salon2}
        alt="Salon"
        class="rounded w-100 align-middle"
        loading="eager"
      />
      <Image
        src={salon5}
        alt="Utensilien"
        class="rounded w-100 align-middle mt-4"
        loading="eager"
      />
    </div>
    <div
      class="md:flex-[25%] md:max-w-[25%] sm:flex-[50%] sm:max-w-[50%] flex-[100%] max-w-[100%]"
    >
      <Image
        src={salon3}
        alt="Salon"
        class="rounded w-100 align-middle"
        loading="eager"
      />

      <Image
        src={salon7}
        alt="Produkte"
        class="rounded w-100 align-middle mt-4"
        loading="eager"
      />
    </div>
    <div
      class="md:flex-[25%] md:max-w-[25%] sm:flex-[calc(50%_-_2rem)] sm:max-w-[calc(50%_-_2rem)] sm:translate-y-[-66.5vw] md:translate-y-0 flex-[100%] max-w-[100%]"
    >
      <Image
        src={salon8}
        alt="Friseurinnen"
        class="rounded w-100 align-middle"
        loading="eager"
      />
      <Image
        src={salon4}
        alt="Büsten"
        class="rounded w-100 align-middle mt-4"
        loading="eager"
      />
    </div>
  </div>
</Card>
