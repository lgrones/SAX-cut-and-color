---
import Card from "../card/card.astro";
import salon2 from "../../assets/salon/salon2.jpeg";
import salon3 from "../../assets/salon/salon3.jpeg";
import salon4 from "../../assets/salon/salon4.jpeg";
import salon5 from "../../assets/salon/salon5.jpg";
import salon7 from "../../assets/salon/salon7.jpeg";
import salon8 from "../../assets/salon/salon8.jpeg";
import { Image } from "astro:assets";
---

<Card title="Salon" id="salon">
  <div class="gallery">
    <div class="column column-1">
      <Image
        src={salon2}
        alt="Salon"
        class="photo"
        loading="eager"
      />
      <Image
        src={salon5}
        alt="Utensilien"
        class="photo"
        loading="eager"
      />
    </div>
    <div class="column column-2">
      <Image
        src={salon3}
        alt="Salon"
        class="photo"
        loading="eager"
      />

      <Image
        src={salon7}
        alt="Produkte"
        class="photo"
        loading="eager"
      />
    </div>
    <div class="column column-3">
      <Image
        src={salon8}
        alt="Friseurinnen"
        class="photo"
        loading="eager"
      />
      <Image
        src={salon4}
        alt="Büsten"
        class="photo"
        loading="eager"
      />
    </div>
  </div>
</Card>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .column {
    flex: 1 1 100%;
    max-width: 100%;
  }

  .photo {
    border-radius: 0.25rem;

    & + & {
      margin-top: 1rem;
    }
  }

  @media (min-width: 640px) {
    .column-1,
    .column-3 {
      flex-basis: calc(50% - 2rem);
      max-width: calc(50% - 2rem);
    }

    .column-2 {
      flex-basis: 50%;
      max-width: 50%;
    }

    .column-3 {
      translate: 0 -66.5vw;
    }
  }

  @media (min-width: 768px) {
    .column-2,
    .column-3 {
      flex-basis: 25%;
      max-width: 25%;
    }

    .column-3 {
      translate: none;
    }
  }
</style>
