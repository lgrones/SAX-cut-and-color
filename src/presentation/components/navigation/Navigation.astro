---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { contact } from '@domain/contact';
import Icon from '../icon/icon.astro';

const links = [
  { name: 'Angebote', id: 'angebote' },
  { name: 'Preise', id: 'preise' },
  { name: 'Salon', id: 'salon' },
  { name: 'Zeiten', id: 'zeiten' },
  { name: 'Kontakt', id: 'kontakt' },
];
---

<header id="site-header">
  <div class="bar">
    <a
      class="home"
      href="/"
      aria-label="SAX Cut + Colour by Petra Zangerl – zur Startseite"
    >
      <Image
        src={logo}
        alt="SAX Cut + Colour by Petra Zangerl"
        loading="eager"
        class="logo"
      />
    </a>

    <nav aria-label="Hauptnavigation">
      {links.map(({ name, id }) => (
        <a href={`/#${id}`}>{name}</a>
      ))}
    </nav>

    <a class="btn btn-gold call" href={contact.phone.href}>
      <Icon name="phone" size={16} strokeWidth={1.6} />
      <span>
        Termin<span class="call-rest"> vereinbaren</span>
      </span>
    </a>
  </div>
</header>

<style>
  /* sticky, slides away while scrolling down and back on scrolling up */
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--bg);
    border-bottom: 1px solid var(--gold-soft);
    transition: translate 0.3s ease;

    &.hidden {
      translate: 0 -100%;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  /* one row on wide screens; below that logo and call button share the first
     row and the links get a row of their own instead of wrapping */
  .bar {
    display: grid;
    grid-template-areas: 'logo nav call';
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px 32px;
    max-width: 1240px;
    margin-inline: auto;
    padding: 18px var(--gutter);

    @media (width < 1000px) {
      grid-template-areas:
        'logo call'
        'nav nav';

      /* minmax(0, …) keeps a too wide nav row from widening the grid past
         the viewport */
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
      padding-block: 12px 0;
    }
  }

  .home {
    grid-area: logo;
    justify-self: start;
  }

  .logo {
    width: auto;
    height: 72px;

    @media (width < 1000px) {
      height: 56px;
    }
  }

  nav {
    display: flex;
    grid-area: nav;
    justify-content: center;
    column-gap: 28px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;

    @media (width < 1000px) {
      justify-content: flex-start;
      min-width: 0;

      /* last resort on very narrow screens: scroll instead of wrapping */
      overflow-x: auto;
      scrollbar-width: none;
    }

    @media (width < 560px) {
      justify-content: space-between;
      column-gap: 8px;
      font-size: clamp(11px, 3.2vw, 14px);
      letter-spacing: 0.04em;
    }

    & a {
      padding-block: 12px;
      transition: color 0.2s;

      &:hover {
        color: var(--gold-light);
      }
    }
  }

  .call {
    grid-area: call;
    min-height: 44px;
    padding-inline: 22px;
    font-size: 12px;

    @media (width < 480px) {
      padding-inline: 16px;
    }
  }

  .call-rest {
    @media (width < 360px) {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');

  if (header) {
    // ignore small jitter, e.g. from momentum scrolling
    const THRESHOLD = 8;
    let lastY = window.scrollY;
    // while jumping to a section the header stays out of the way, also when
    // the jump goes up
    let jumping = false;

    const setHidden = (hidden: boolean) =>
      header.classList.toggle('hidden', hidden);

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;

        if (jumping) {
          lastY = y;
          return;
        }

        if (y <= header.offsetHeight) {
          setHidden(false);
        } else if (Math.abs(y - lastY) > THRESHOLD) {
          setHidden(y > lastY);
        } else {
          return;
        }

        lastY = y;
      },
      { passive: true },
    );

    const endJump = () => {
      jumping = false;
      lastY = window.scrollY;
    };

    document.addEventListener('click', e => {
      const link = (e.target as Element | null)?.closest('a[href*="#"]');
      if (!(link instanceof HTMLAnchorElement)) return;
      if (link.pathname !== window.location.pathname || !link.hash) return;

      jumping = true;
      setHidden(true);
      // scrollend is missing in older Safari
      window.addEventListener('scrollend', endJump, { once: true });
      setTimeout(endJump, 1500);
    });

    // keyboard users tabbing into the header always see it
    header.addEventListener('focusin', () => setHidden(false));
  }
</script>
