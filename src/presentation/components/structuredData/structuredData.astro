---
import type { StartPage } from '@business/startPage/getStartPage';
import type { Contact } from '@domain/contact';
import { hairSalon, jsonLd } from './hairSalon';

interface Props {
  startPage: StartPage;
  contact: Contact;
}

const { startPage, contact } = Astro.props;
---

<script
  type="application/ld+json"
  is:inline
  set:html={jsonLd(hairSalon(startPage, contact, Astro.site))}
/>
