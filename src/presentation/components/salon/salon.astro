---
import Loading from '../loading/loading.astro';
import GalleryList from './galleryList.astro';
---

<section id="salon" class="section salon">
  <div class="heading">
    <p class="eyebrow">04 — Salon</p>
    <h2 class="heading-section">Einblicke</h2>
  </div>

  <GalleryList server:defer>
    <Loading slot="fallback" minHeight="34rem" />
  </GalleryList>
</section>

<style>
  .salon {
    display: flex;
    flex-direction: column;
    row-gap: 56px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }
</style>
