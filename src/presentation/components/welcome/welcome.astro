---
import type { ImageSource } from '@business/images/imageSource';

interface Props {
  /** Left out while the admin has no portrait */
  photo: ImageSource | undefined;
}

const { photo } = Astro.props;

// The photo is its frame, at most 482px, less the frame's 22px. One column
// below 900px, two from there, each wide enough for the whole frame from 1120px.
const sizes = [
  '(min-width: 1120px) 460px',
  '(min-width: 900px) calc(43vw - 22px)',
  '(min-width: 524px) 460px',
  '(min-width: 400px) calc(92vw - 22px)',
  'calc(100vw - 54px)',
].join(', ');
---

<section class="band">
  <div class:list={['section', 'welcome', !photo && 'text-only']}>
    <div class="text">
      <p class="eyebrow">
        <span class="eyebrow-numbered">Willkommen</span>
      </p>
      <p class="quote serif">
        Ob neuer Schnitt, neue Farbe oder die Frisur für einen besonderen Anlass
        – ich helfe Ihnen, Ihren Look zu finden.
      </p>
      <p class="body">
        Seit vielen Jahren arbeite ich als Friseurin, und eines ist dabei gleich
        geblieben: Im Mittelpunkt stehen Sie. Ich nehme mir Zeit, Ihre Wünsche
        zu verstehen, und arbeite ausschließlich mit hochwertigen Produkten.
      </p>
      <div class="signature">
        <span class="name serif accent">Petra Otti</span>
        <span class="role">Inhaberin</span>
      </div>
    </div>

    {photo && (
      <div class="frame">
        <img
          src={photo.src}
          srcset={photo.srcset}
          sizes={sizes}
          width={photo.width}
          height={photo.height}
          alt={photo.alt}
          loading="lazy"
          decoding="async"
          class="photo"
        />
      </div>
    )}
  </div>
</section>

<style>
  /* text first on small screens, photo beside it on the left once both fit */
  .welcome {
    display: grid;
    grid-template-areas:
      'text'
      'photo';
    gap: clamp(40px, 6vw, 96px);
    align-items: center;

    @media (width >= 900px) {
      grid-template-areas: 'photo text';
      grid-template-columns: 1fr 1fr;
    }
  }

  /* without a portrait the text takes one readable column */
  .welcome.text-only {
    grid-template-areas: 'text';
    grid-template-columns: minmax(0, 760px);
  }

  /* offset gold frame behind the photo, mirrored to the hero's */
  .frame {
    position: relative;
    grid-area: photo;
    width: 100%;
    max-width: 482px;
    padding: 0 0 22px 22px;

    &::before {
      content: '';
      position: absolute;
      inset: 22px 22px 0 0;
      border: 1px solid var(--gold);
    }
  }

  .photo {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .text {
    display: flex;
    grid-area: text;
    flex-direction: column;
    row-gap: 28px;
  }

  .quote {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.25;
    text-wrap: pretty;
  }

  .body {
    max-width: 34em;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .signature {
    display: flex;
    flex-direction: column;
    row-gap: 2px;
  }

  .name {
    font-size: 30px;
  }

  .role {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
</style>
