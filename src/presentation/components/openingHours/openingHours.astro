---
import Loading from '../loading/loading.astro';
import Days from './days.astro';
---

<div id="zeiten" class="column">
  <div class="heading">
    <p class="eyebrow">05 — Zeiten</p>
    <h2 class="heading-column">Öffnungszeiten</h2>
  </div>

  <Days server:defer>
    <Loading slot="fallback" minHeight="30rem" />
  </Days>
</div>

<style>
  .column {
    display: flex;
    flex-direction: column;
    row-gap: 32px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }
</style>
