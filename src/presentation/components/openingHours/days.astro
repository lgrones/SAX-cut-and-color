---
import { getOpeningHours } from '@business/openingHours/getOpeningHours';
import { OpeningHours } from '@domain/openingHours';

const openingHours = await getOpeningHours();

const days = openingHours
  .filter(x => !x.closed)
  .map(x => ({ day: x.day, ranges: OpeningHours.ranges(x) }))
  .filter(x => x.ranges.length > 0);

// Always fetch fresh data so admin edits show up on the next page view
Astro.response.headers.set('Cache-Control', 'no-store');
---

<div class="days">
  {days.map(({ day, ranges }) => (
    <div class="day">
      <div class="name">{day}</div>
      <div>
        {ranges.map(([start, end]) => (
          <div>
            {start} - {end} Uhr
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .days {
    display: flex;
    flex-direction: column;
    row-gap: 1rem;
  }

  .day {
    display: flex;
    justify-content: space-between;
    column-gap: 3.5rem;
    text-wrap: nowrap;

    @media (min-width: 640px) {
      column-gap: 6rem;
    }
  }

  .name {
    font-weight: 500;
    letter-spacing: 0.025em;
  }
</style>
