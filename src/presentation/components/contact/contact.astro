---
import { Image } from 'astro:assets';
import Card from '../card/card.astro';
import map from '../../assets/map.png';
import { contact } from '@domain/contact';

const rows = [
  { title: 'Telefon', ...contact.phone, external: false },
  { title: 'E-Mail', ...contact.email, external: false },
  { title: 'Adresse', ...contact.address, external: true },
];
---

<Card title="Kontakt" id="contact">
  <div class="rows">
    {rows.map(({ title, href, label, external }) => (
      <div class="row">
        <div class="title">{title}</div>
        <a
          href={href}
          target={external ? '_blank' : undefined}
          class="text-link"
        >
          {label}
        </a>
      </div>
    ))}
  </div>

  <div slot="image" class="map">
    <Image src={map} alt="Karte" loading="eager" class="map-image" />

    <a class="map-link text-link" href={contact.address.href} target="_blank">
      Zur Karte
    </a>
  </div>
</Card>

<style>
  .rows {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    row-gap: 1.5rem;
    padding-bottom: 240px;

    @media (min-width: 1280px) {
      padding-right: 18rem;
      padding-bottom: 0;
    }
  }

  .row {
    display: flex;
    justify-content: space-between;
    column-gap: 2.5rem;
    text-wrap: nowrap;

    @media (min-width: 768px) {
      column-gap: 6rem;
    }
  }

  .title {
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  .map {
    position: absolute;
    right: 0;
    bottom: 0;

    @media (min-width: 1280px) {
      top: 0;
      bottom: auto;
    }
  }

  .map-image {
    width: auto;
    height: 208px;
    border-radius: 0.25rem;
  }

  .map-link {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 20;
    text-shadow: black 0.1em 0.1em 0.2em;
  }
</style>
