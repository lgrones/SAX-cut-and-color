---
import { Image } from 'astro:assets';
import { contact } from '@domain/contact';
import map from '../../assets/map.png';
import Icon from '../icon/icon.astro';
---

<div id="kontakt" class="column">
  <div class="heading">
    <p class="eyebrow">06 — Kontakt</p>
    <h2 class="heading-column">So finden Sie mich</h2>
  </div>

  <div class="rows">
    <a class="row" href={contact.phone.href}>
      <Icon name="phone" size={22} strokeWidth={1.5} />
      {contact.phone.label}
    </a>
    <a class="row" href={contact.whatsapp.href} target="_blank" rel="noopener">
      <Icon name="chat" size={22} strokeWidth={1.5} />
      {contact.whatsapp.label}
    </a>
    <a class="row" href={contact.email.href}>
      <Icon name="mail" size={22} strokeWidth={1.5} />
      {contact.email.label}
    </a>
    <div class="row">
      <Icon name="pin" size={22} strokeWidth={1.5} />
      {contact.address.label}
    </div>
  </div>

  <div class="map">
    <Image
      src={map}
      alt="Karte: SAX Cut + Colour in Lochau, zwischen Bregenz und Lindau"
      class="map-image"
    />
    <a
      class="btn btn-sm btn-ghost map-link"
      href={contact.address.href}
      target="_blank"
      rel="noopener"
    >
      Zur Karte
    </a>
  </div>
</div>

<style>
  .column {
    display: flex;
    flex-direction: column;
    row-gap: 32px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }

  .rows {
    display: flex;
    flex-direction: column;
    row-gap: 18px;
  }

  .row {
    display: flex;
    align-items: center;
    column-gap: 16px;
    min-height: 44px;
    font-size: 19px;
    overflow-wrap: anywhere;

    & svg {
      flex-shrink: 0;
      color: var(--gold);
    }
  }

  a.row:hover {
    color: var(--gold-light);
  }

  .map {
    position: relative;
    border: 1px solid var(--gold-soft);
  }

  .map-image {
    width: 100%;
    aspect-ratio: 433 / 265;
    object-fit: cover;
  }

  .map-link {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background-color: var(--bg);
  }
</style>
