---
import Loading from '../loading/loading.astro';
import PriceCards from './priceCards.astro';
---

<div id="prices">
  <PriceCards server:defer>
    <Loading slot="fallback" minHeight="24rem" />
  </PriceCards>

  <p class="note">Bezahlung nur in Bar. Keine Kartenzahlung möglich.</p>
</div>

<style>
  .note {
    padding-top: 5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--sax-tan);
  }
</style>
