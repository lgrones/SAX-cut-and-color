---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="section legal">
  <h1 class="heading-section">{title}</h1>
  <slot />
</section>

<style>
  /* the text comes through the slot, so it is styled from here as global */
  .legal {
    max-width: calc(70ch + 2 * var(--gutter));
    color: var(--text-muted);

    & :global(address) {
      font-style: normal;
    }

    & :global(h2) {
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      font-family: var(--font-serif);
      font-size: 1.75rem;
      line-height: 1.2;
      color: var(--gold);
    }

    & :global(p + p),
    & :global(address + p) {
      margin-top: 0.75rem;
    }

    & :global(ul) {
      padding-left: 1.25rem;
      list-style: disc;
    }
  }

  h1 {
    margin-bottom: 2.5rem;
    color: var(--text);
  }
</style>
