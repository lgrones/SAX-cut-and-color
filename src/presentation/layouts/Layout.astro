---
import { Font, Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Navigation from '../components/navigation/Navigation.astro';
import { SEOMetadata } from 'astro-seo-metadata';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  disableScrollSmooth?: boolean;
}

const {
  title,
  description = 'Friseursalon SAX Cut + Colour by Petra Zangerl in Lochau: Schnitt, Farbe und Pflege. Landstraße 46, 6911 Lochau.',
  disableScrollSmooth,
} = Astro.props;
---

<!doctype html>
<html lang="de" class:list={{ 'scroll-smooth': !disableScrollSmooth }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOMetadata
      siteName="Sax Cut + Colour"
      title={title}
      description={description}
      favicon="/favicon.png"
      author="Petra Zangerl"
      astroSitemap
      canonicalUrl={Astro.url.toString()}
      type="website"
      astroGenerator
    />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <Navigation />

    <main>
      <slot />
    </main>

    <footer>
      <a
        href="/"
        aria-label="SAX Cut + Colour by Petra Zangerl – zur Startseite"
      >
        <Image
          src={logo}
          alt="SAX Cut + Colour by Petra Zangerl"
          class="logo"
        />
      </a>
      <nav aria-label="Rechtliches">
        <a href="/legal-notice">Impressum</a>
        <a href="/admin">Admin</a>
        <span>© {new Date().getFullYear()}</span>
      </nav>
    </footer>

    <style>
      body {
        font-size: 17px;
        color: var(--text);
        background-color: var(--bg);
        -webkit-font-smoothing: antialiased;
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px 40px;
        max-width: 1240px;
        margin-inline: auto;
        padding: 40px var(--gutter) 48px;
        font-size: 14px;
        color: var(--text-subtle);
      }

      .logo {
        width: auto;
        height: 56px;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 28px;

        & a:hover {
          color: var(--gold-light);
        }
      }
    </style>
  </body>
</html>
