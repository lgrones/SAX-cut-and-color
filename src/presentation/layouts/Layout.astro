---
import type { StartPage } from '@business/startPage/getStartPage';
import { Contact } from '@domain/contact';
import { Font, Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Navigation from '../components/navigation/Navigation.astro';
import { SEOMetadata } from 'astro-seo-metadata';
import '../styles/global.css';

interface Props {
  title: string;
  startPage: StartPage;
  contact: Contact;
  description?: string;
  disableScrollSmooth?: boolean;
}

const {
  title,
  startPage,
  contact,
  description = `Friseursalon SAX Cut + Colour by Petra Zangerl: Schnitt, Farbe und Pflege. ${Contact.address(contact)}.`,
  disableScrollSmooth,
} = Astro.props;

// Rendered on Cloud Run behind Hosting, where the request URL carries the
// service's own host instead of the site's
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
// A fixed salon photo in the 1200×630 social networks expect, served by
// Hosting: an admin photo would need its own crop and fresh URLs, as shares
// cache the image for weeks
const socialImage = new URL('/og-image.jpg', Astro.site).toString();
---

<!doctype html>
<html lang="de" class:list={{ 'scroll-smooth': !disableScrollSmooth }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOMetadata
      siteName="Sax Cut + Colour"
      title={title}
      description={description}
      favicon="/favicon.png"
      author="Petra Zangerl"
      astroSitemap
      canonicalUrl={canonicalUrl}
      image={socialImage}
      type="website"
      astroGenerator
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="de_AT" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <slot name="head" />
  </head>
  <body>
    <Navigation startPage={startPage} contact={contact} />

    <main>
      <slot />
    </main>

    <footer>
      <a
        href="/"
        aria-label="SAX Cut + Colour by Petra Zangerl – zur Startseite"
      >
        <Image
          src={logo}
          alt="SAX Cut + Colour by Petra Zangerl"
          class="logo"
        />
      </a>
      <nav aria-label="Rechtliches">
        <a href="/legal-notice">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <span>© {new Date().getFullYear()}</span>
      </nav>
    </footer>

    <style>
      body {
        font-size: 17px;
        color: var(--text);
        background-color: var(--bg);
        -webkit-font-smoothing: antialiased;
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px 40px;
        max-width: 1240px;
        margin-inline: auto;
        padding: 40px var(--gutter) 48px;
        font-size: 14px;
        color: var(--text-subtle);
      }

      .logo {
        width: auto;
        height: 56px;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 28px;

        & a:hover {
          color: var(--gold-light);
        }
      }
    </style>
  </body>
</html>
