---
import Footer from "../components/footer/footer.astro";
import Navigation from "../components/navigation/Navigation.astro";
import { SEOMetadata } from "astro-seo-metadata";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEOMetadata
      siteName={"Sax Cut + Colour"}
      title={title}
      description={"Entdecken Sie bei SAX die Kunst der Haarpflege und des Stylings. Unsere erfahrene Friseurin verwöhnt Sie mit maßgeschneiderten Schnitten, trendigen Farben und professionellen Pflegebehandlungen. Vereinbaren Sie noch heute einen Termin und erleben Sie Schönheit und Entspannung in unserem gemütlichen Salon."}
      favicon={"/favicon.png"}
      author="Petra Zangerl"
      astroSitemap={true}
      canonicalUrl={Astro.url.toString()}
      type={"website"}
      astroGenerator={true}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-sax-dark container mx-auto max-w-screen-xl px-6">
    <Navigation />

    <main class="my-8 flex gap-y-12 md:gap-y-24 flex-col relative z-10">
      <slot />
    </main>

    <Footer />

    <div
      class="rounded-full border border-t-0 border-sax-tan opacity-25 fixed z-0 aspect-square w-full xl:w-4/6 start-0 end-0 -top-32 mx-auto"
    >
    </div>

    <div
      class="rounded-full border border-t-0 border-sax-tan opacity-25 fixed z-0 aspect-square w-full md:w-4/6 start-48 end-48 top-2/3 sm:hidden mx-auto"
    >
    </div>

    <script src="../../node_modules/flowbite/dist/flowbite.min.js"></script>
    <style is:global>
      :root {
        --accent: 213, 177, 129;
        color-scheme: dark;
      }
      html {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      * {
        margin: 0;
      }
    </style>
  </body>
</html>
