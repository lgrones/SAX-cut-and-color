---
import Footer from '../components/footer/footer.astro';
import Navigation from '../components/navigation/Navigation.astro';
import { SEOMetadata } from 'astro-seo-metadata';
import '../styles/global.css';

interface Props {
  title: string;
  disableScrollSmooth?: boolean;
}

const { title, disableScrollSmooth } = Astro.props;

const description =
  'Entdecken Sie bei SAX die Kunst der Haarpflege und des Stylings. ' +
  'Unsere erfahrene Friseurin verwöhnt Sie mit maßgeschneiderten Schnitten, ' +
  'trendigen Farben und professionellen Pflegebehandlungen. Vereinbaren Sie ' +
  'noch heute einen Termin und erleben Sie Schönheit und Entspannung in ' +
  'unserem gemütlichen Salon.';
---

<!doctype html>
<html lang="de" class:list={{ 'scroll-smooth': !disableScrollSmooth }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEOMetadata
      siteName="Sax Cut + Colour"
      title={title}
      description={description}
      favicon="/favicon.png"
      author="Petra Zangerl"
      astroSitemap
      canonicalUrl={Astro.url.toString()}
      type="website"
      astroGenerator
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navigation />

    <main>
      <slot />
    </main>

    <Footer />

    <div class="ring ring-top"></div>
    <div class="ring ring-bottom"></div>

    <style>
      body {
        width: 100%;
        max-width: 1280px;
        margin-inline: auto;
        padding-inline: 1.5rem;
        background-color: var(--sax-dark);
      }

      main {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        row-gap: 3rem;
        margin-block: 2rem;

        @media (min-width: 768px) {
          row-gap: 6rem;
        }
      }

      .ring {
        position: fixed;
        z-index: 0;
        width: 100%;
        aspect-ratio: 1 / 1;
        margin-inline: auto;
        border: 1px solid var(--sax-tan);
        border-top-width: 0;
        border-radius: 9999px;
        opacity: 0.25;
      }

      .ring-top {
        inset-inline: 0;
        top: -8rem;

        @media (min-width: 1280px) {
          width: calc(200% / 3);
        }
      }

      .ring-bottom {
        inset-inline: 12rem;
        top: calc(200% / 3);

        @media (min-width: 640px) {
          display: none;
        }
      }
    </style>
  </body>
</html>
