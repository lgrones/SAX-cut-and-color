---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import teaser from "../assets/teaser.jpg";
import Card from "../components/card/card.astro";
---

<Layout title="SAX Cut + Colour">
  <Image
    src={teaser}
    alt="Teaser"
    class="w-full rounded-lg sepia-[.4] border border-tan-300"
  />

  <Card title="Zeiten">
    <div class="flex gap-x-10 gap-y-6 flex-wrap">
      <div>
        <div class="text-lg mb-1">Montag</div>
        <div>Geschlossen</div>
      </div><div>
        <div class="text-lg mb-1">Dienstag</div>
        <div>Geschlossen</div>
      </div><div>
        <div class="text-lg mb-1">Mittwoch</div>
        <div>Geschlossen</div>
      </div><div>
        <div class="text-lg mb-1">Donnerstag</div>
        <div>Geschlossen</div>
      </div><div>
        <div class="text-lg mb-1">Freitag</div>
        <div>Geschlossen</div>
      </div>
    </div>
  </Card>
</Layout>

<style></style>
