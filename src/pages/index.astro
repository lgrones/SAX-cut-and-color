---
import { getContact } from '@business/contact/getContact';
import { getStartPage } from '@business/startPage/getStartPage';
import { CACHE_CONTROL } from '@infrastructure/cacheControl';
import { SESSION_COOKIE } from '@infrastructure/sessionCookie';
import Closing from '@presentation/components/closing/closing.astro';
import Contact from '@presentation/components/contact/contact.astro';
import Hero from '@presentation/components/hero/hero.astro';
import Offers from '@presentation/components/offers/offers.astro';
import OpeningHours from '@presentation/components/openingHours/openingHours.astro';
import Prices from '@presentation/components/prices/prices.astro';
import Salon from '@presentation/components/salon/salon.astro';
import StructuredData from '@presentation/components/structuredData/structuredData.astro';
import Welcome from '@presentation/components/welcome/welcome.astro';
import Layout from '@presentation/layouts/Layout.astro';

// Rendered on request and kept briefly by the CDN, so admin edits and the day
// change show up within a minute (for the signed in admin on the next view). A
// failed load throws before the header is set, so the error page is never cached
const [startPage, contact] = await Promise.all([getStartPage(), getContact()]);
const { prices, offers, gallery, hours, hero, portrait, map } = startPage;

Astro.response.headers.set(
  'Cache-Control',
  Astro.cookies.has(SESSION_COOKIE)
    ? CACHE_CONTROL.signedIn
    : CACHE_CONTROL.startPage,
);

// The hero is the largest paint, so the connection to its storage host opens
// while the browser still reads the head. No crossorigin: the image is fetched
// without CORS, and a CORS preconnect would be a second connection.
const imageOrigin = hero && new URL(hero.src, Astro.site).origin;
const preconnect = imageOrigin !== Astro.site?.origin ? imageOrigin : undefined;
---

<Layout
  title="SAX Cut + Colour – Friseursalon in Lochau"
  startPage={startPage}
  contact={contact}
>
  <Fragment slot="head">
    {preconnect && <link rel="preconnect" href={preconnect} />}
    <StructuredData startPage={startPage} contact={contact} />
  </Fragment>

  <Hero
    photo={hero}
    week={hours}
    hasPrices={prices.length > 0}
    contact={contact}
  />
  <Welcome photo={portrait} />

  <!-- A section the admin switched off or that has no content is left out -->
  {prices.length > 0 && <Prices categories={prices} />}
  {offers.length > 0 && <Offers offers={offers} contact={contact} />}
  {gallery.length > 0 && <Salon images={gallery} />}

  <section class="visit">
    <div class="section visit-grid">
      {hours.length > 0 && <OpeningHours week={hours} />}
      <Contact contact={contact} map={map} />
    </div>
  </section>

  <Closing contact={contact} />
</Layout>

<style>
  .visit {
    background-color: var(--bg-alt);
    border-top: 1px solid var(--gold-faint);
  }

  /* auto-fill keeps the empty column, so the contact stays half wide without
     the opening hours */
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(460px, 100%), 1fr));
    gap: 72px 96px;
  }
</style>
