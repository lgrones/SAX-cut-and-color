---
import Contact from "../components/contact/contact.astro";
import Offers from "../components/offers/offers.astro";
import OpeningHours from "../components/openingHours/openingHours.astro";
import Prices from "../components/prices/prices.astro";
import Salon from "../components/salon/salon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="SAX Cut + Colour">
  <h1
    class="font-cormorant text-sax-tan text-5xl md:text-7xl lg:text-8xl uppercase tracking-wide pt-[100px] md:pt-[120px] max-w-[400px] sm:max-w-[550px] md:max-w-[800px] lg:max-w-[1100px]"
  >
    Schönheit beginnt bei den Haaren
  </h1>

  <div class="flex justify-between flex-wrap gap-x-24 gap-y-14">
    <OpeningHours />

    <Contact />
  </div>

  <Prices />

  <Offers />

  <Salon />
</Layout>
