---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import teaser from "../assets/teaser.jpg";
import Card from "../components/card/card.astro";
import OpeningHours from "../components/openingHours/openingHours.astro";
---

<Layout title="SAX Cut + Colour">
  <div class="relative">
    <h1
      class="font-cormorant text-sax-tan text-8xl uppercase w-[800px] relative z-10 tracking-wide [text-shadow:-5px_0_26px_black,5px_0_26px_black,0_5px_26px_black,0_-5px_26px_black]"
    >
      Schönheit beginnt bei den Haaren
    </h1>

    <Image
      src={teaser}
      alt="Teaser"
      class="absolute end-0 top-0 w-2/3 rounded sepia-[.4] opacity-50 z-0"
    />
  </div>
  <OpeningHours />
</Layout>

<style></style>
