---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import Layout from "../layouts/Layout.astro";
import OpeningHoursForm from "../components/admin/openingHours/openingHoursForm.astro";
import PricesForm from "../components/admin/prices/pricesForm.astro";
import OffersForm from "../components/admin/offers/offersForm.astro";

if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

try {
  const auth = getAuth(app);

  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);

  if (!decodedCookie) {
    return Astro.redirect("/signin");
  }
} catch (error) {
  console.error(error);
  return Astro.redirect("/signin");
}
---

<Layout title="Admin Bereich" disableScrollSmooth>
  <OpeningHoursForm />

  <PricesForm />

  <OffersForm />

  <form action="/api/auth/signout">
    <button
      type="submit"
      class="mt-8 text-sax-dark bg-sax-tan hover:bg-sax-tan/90 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center"
      >Ausloggen</button
    >
  </form>
</Layout>
