---
export const prerender = false;

import Layout from '@presentation/layouts/Layout.astro';
import OpeningHoursForm from '@presentation/components/admin/openingHours/openingHoursForm.astro';
import PricesForm from '@presentation/components/admin/prices/pricesForm.astro';
import OffersForm from '@presentation/components/admin/offers/offersForm.astro';

// Access is checked by the auth middleware
---

<Layout title="Admin Bereich" disableScrollSmooth>
  <OpeningHoursForm />

  <PricesForm />

  <OffersForm />

  <form method="post" action="/api/auth/signout">
    <button type="submit" class="button form-submit">
      Ausloggen
    </button>
  </form>
</Layout>
