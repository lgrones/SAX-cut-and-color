<style>
  address {
    font-style: normal;
  }

  h2 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-cormorant);
    font-size: 1.5rem;
    line-height: 2rem;

    &:first-child {
      margin-top: 0;
    }
  }
</style>
