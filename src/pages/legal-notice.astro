---
import { getContact } from '@business/contact/getContact';
import { getStartPage } from '@business/startPage/getStartPage';
import { CACHE_CONTROL } from '@infrastructure/cacheControl';
import { SESSION_COOKIE } from '@infrastructure/sessionCookie';
import LegalPage from '@presentation/components/legal/legalPage.astro';
import OwnerAddress from '@presentation/components/legal/ownerAddress.astro';
import Layout from '@presentation/layouts/Layout.astro';

// Rendered on request for the contact details, which the admin edits; the
// navigation also links only the sections the start page shows
const [startPage, contact] = await Promise.all([getStartPage(), getContact()]);
Astro.response.headers.set(
  'Cache-Control',
  Astro.cookies.has(SESSION_COOKIE)
    ? CACHE_CONTROL.signedIn
    : CACHE_CONTROL.legalPages,
);
---

<Layout
  title="SAX Cut + Colour Impressum"
  startPage={startPage}
  contact={contact}
>
  <LegalPage title="Impressum">
    <p>Angaben gemäß § 5 ECG, § 14 UGB und § 25 MedienG</p>

    <h2>Unternehmen</h2>
    <OwnerAddress contact={contact} />
    <p>UID-Nr.: ATU 63588237</p>

    <h2>Firmenbuch</h2>
    <p>
      FN 62067a, Landesgericht Feldkirch
      <br />
      Sitz: Lochau [TODO Inhaberin: Sitz laut Firmenbuch bestätigen]
    </p>

    <h2>Gewerbe und Aufsicht</h2>
    <p>
      Gewerbe: Friseurin und Perückenmacherin (Stylistin) (Handwerk) gemäß § 94
      Z 22 GewO 1994
      <br />
      Gewerbebehörde: Bezirkshauptmannschaft Bregenz
      <br />
      Kammer: Wirtschaftskammer Vorarlberg, Landesinnung der Friseure [TODO
      Inhaberin: Kammer und Innung bestätigen]
      <br />
      Berufsrechtliche Vorschriften: Gewerbeordnung 1994 (GewO), abrufbar im
      Rechtsinformationssystem des Bundes unter{' '}
      <a href="https://www.ris.bka.gv.at" class="text-link">
        www.ris.bka.gv.at
      </a>
    </p>

    <h2>Offenlegung gemäß § 25 MedienG</h2>
    <p>
      Medieninhaberin: Petra Otti, Inhaberin von SAX Cut + Colour by Petra Otti,
      Sitz in Lochau
      <br />
      Unternehmensgegenstand: Friseursalon
      <br />
      Grundlegende Richtung: Information über den Friseursalon, seine
      Leistungen, Preise und Öffnungszeiten
    </p>
  </LegalPage>
</Layout>
