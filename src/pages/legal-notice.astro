---
import Layout from '@presentation/layouts/Layout.astro';
import { contact } from '@domain/contact';
---

<Layout title="SAX Cut + Colour Impressum">
  <section class="section">
    <h2>Name & Kontaktdaten des Anbieters</h2>
    <address>
      Sax Cut + Colour by Petra Zangerl
      <br />
      Landstraße 46
      <br />
      6911 Lochau
      <br />
      Austria
      <br />
      <a href={contact.phone.href} class="text-link">
        {contact.phone.label}
      </a>
      <br />
      <a href={contact.email.href} class="text-link">
        {contact.email.label}
      </a>
      <br />
      ATU 63588237
    </address>

    <h2>Firmenbuchnummer und Firmenbuchgericht</h2>
    <p>FN 62067a, Landesgericht Feldkirch</p>

    <h2>Gewerbeberechtigung</h2>
    <p>
      Friseurin und Perückenmacherin (Stylistin) (Handwerk) gemäß § 94 Z 22 GewO
      1994
