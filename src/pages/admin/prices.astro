---
import { getPrices } from '@business/prices/getPrices';
import { getHiddenSections } from '@business/pageSections/getHiddenSections';
import { PageSection } from '@domain/pageSection';
import AdminLayout from '@presentation/layouts/AdminLayout.astro';
import { AdminSection } from '@presentation/layouts/adminSection';
import { SectionToggle } from '@presentation/components/admin/pageSections/sectionToggle';
import { PricesEditor } from '@presentation/components/admin/prices/pricesEditor';

// Access is checked by the auth middleware
const [prices, hidden] = await Promise.all([getPrices(), getHiddenSections()]);
---

<AdminLayout
  section={AdminSection.prices}
  title="Preise"
  description="Erscheinen auf der Startseite unter „Preise“, in dieser Reihenfolge. Zum Ändern antippen, zum Verschieben am Griff ziehen."
>
  <SectionToggle
    section={PageSection.prices}
    shown={!hidden.includes(PageSection.prices)}
    client:load
  />
  <PricesEditor prices={prices} client:load />
</AdminLayout>
