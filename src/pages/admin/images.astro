---
export const prerender = false;

import { getImages } from '@business/images/getImages';
import { originalUrl } from '@business/images/imageFiles';
import AdminLayout from '@presentation/layouts/AdminLayout.astro';
import {
  type EditorImages,
  ImagesEditor,
} from '@presentation/components/admin/images/imagesEditor';

// Access is checked by the auth middleware
const { hero, portrait, gallery } = await getImages();

const images: EditorImages = {
  ...(hero && { hero: { ...hero, src: originalUrl(hero.id) } }),
  ...(portrait && { portrait: { ...portrait, src: originalUrl(portrait.id) } }),
  gallery: gallery.map(x => ({ ...x, src: originalUrl(x.id) })),
};
---

<AdminLayout
  section="images"
  title="Bilder"
  description="Startbild, Porträt und Galerie der Startseite. Neue Bilder sind nach dem Speichern innerhalb weniger Minuten zu sehen."
>
  <ImagesEditor images={images} client:load />
</AdminLayout>
