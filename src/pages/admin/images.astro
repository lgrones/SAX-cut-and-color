---
import { getImages } from '@business/images/getImages';
import { withOriginals } from '@business/images/withOriginals';
import AdminLayout from '@presentation/layouts/AdminLayout.astro';
import { AdminSection } from '@presentation/layouts/adminSection';
import { ImagesEditor } from '@presentation/components/admin/images/imagesEditor';

// Access is checked by the auth middleware
const images = withOriginals(await getImages());
---

<AdminLayout
  section={AdminSection.images}
  title="Bilder"
  description="Startbild, Porträt, Karte und Galerie der Startseite. Neue Bilder sind nach dem Speichern innerhalb weniger Minuten zu sehen."
>
  <ImagesEditor images={images} client:load />
</AdminLayout>
