---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import Layout from "../layouts/Layout.astro";
import Card from "../components/card/card.astro";

const auth = getAuth(app);

if (Astro.cookies.has("session")) {
  const sessionCookie = Astro.cookies.get("session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);

  if (decodedCookie) {
    return Astro.redirect("/admin");
  }
}
---

<Layout title="Admin Bereich Login">
  <Card title="Admin Bereich Login" id="login">
    <form action="/api/auth/signin" method="post">
      <div class="grid gap-6 mb-6 md:grid-cols-2 mt-10">
        <div>
          <label for="email" class="block mb-2 text-sax-tan">E-Mail</label>
          <input
            type="email"
            name="email"
            id="email"
            class="text-white bg-stone-800 border-2 border-stone-600 rounded-lg focus:border-sax-tan focus:ring-0 block w-full p-2.5"
            required
          />
        </div>

        <div class="relative">
          <label for="password" class="block mb-2 text-sax-tan">Passwort</label>
          <input
            type="password"
            name="password"
            id="password"
            class="text-white bg-stone-800 border-2 border-stone-600 rounded-lg focus:border-sax-tan focus:ring-0 block w-full p-2.5"
            required
          />
          <span class="text-sax-tan">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="currentColor"
              class="absolute top-[2.85rem] right-4 cursor-pointer"
              id="show"
            >
              <path
                d="m0,10a15,28 0 0,0 20,0 15,28 0 0,0-20,0m14.4 0a4.5,4.5 0 1,1 0-.1zm-2,0a2.4,2.4 0 1,0 0 .1z"
              ></path>
            </svg>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="currentColor"
              viewBox="0 0 17 15"
              class="absolute top-[2.85rem] right-4 cursor-pointer hidden"
              id="hide"
            >
              <path
                d="M1.99 1.99a1 1 0 00-.697 1.717l11 11a1 1 0 101.414-1.414l-.912-.912a8 8 0 002.943-4.391A8 8 0 008 2a8 8 0 00-4.303 1.283l-.99-.99a1 1 0 00-.717-.303zM8 4a4 4 0 014 4 4 4 0 01-.977 2.61L5.39 4.973A4 4 0 018 4zM1.273 5.687A8 8 0 00.262 8.01 8 8 0 008 14a8 8 0 001.445-.14l-1.884-1.885a4 4 0 01-3.532-3.531z"
                style="marker:none"></path><path
                d="M10 8a2 2 0 01-2 2 2 2 0 01-2-2 2 2 0 012-2 2 2 0 012 2z"
              ></path>
            </svg>
          </span>
        </div>
      </div>

      <button
        type="submit"
        class="text-sax-dark bg-sax-tan hover:bg-sax-tan/90 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center"
      >
        Login
      </button>
      <p id="validation" class="mt-2 text-red-500 invisible">
        Falsches Passwort oder E-Mail Adresse
      </p>
    </form>
  </Card>
</Layout>

<script>
  import {
    getAuth,
    inMemoryPersistence,
    signInWithEmailAndPassword,
  } from "firebase/auth";
  import { app } from "../firebase/client";

  const inputs = document.querySelectorAll("input");

  inputs.forEach((input) => {
    input.addEventListener("keydown", () =>
      document.getElementById("validation")?.classList.add("invisible")
    );
  });

  const show = document.getElementById("show");
  const hide = document.getElementById("hide");

  show?.addEventListener("click", () => {
    show.classList.add("hidden");
    hide?.classList.remove("hidden");

    [...inputs].find((x) => x.id === "password")!.type = "text";
  });

  hide?.addEventListener("click", () => {
    hide.classList.add("hidden");
    show?.classList.remove("hidden");

    [...inputs].find((x) => x.id === "password")!.type = "password";
  });

  const auth = getAuth(app);
  // This will prevent the browser from storing session data
  auth.setPersistence(inMemoryPersistence);

  const form = document.querySelector("form") as HTMLFormElement;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get("email")?.toString();
    const password = formData.get("password")?.toString();

    if (!email || !password) {
      return;
    }

    try {
      const userCredential = await signInWithEmailAndPassword(
        auth,
        email,
        password
      );

      const idToken = await userCredential.user.getIdToken();

      const response = await fetch("/api/auth/signin", {
        method: "GET",
        headers: {
          Authorization: `Bearer ${idToken}`,
        },
      });

      if (response.redirected) {
        window.location.assign(response.url);
      }
    } catch (error) {
      document.getElementById("validation")?.classList.remove("invisible");
    }
  });
</script>
