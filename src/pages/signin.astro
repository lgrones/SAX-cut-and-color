---
import '@presentation/styles/admin.css';

// Signed in users are redirected to /admin by the auth middleware
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" />
    <title>Anmelden · SAX Admin</title>
  </head>

  <body>
    <main class="signin">
      <p class="brand">
        SAX <span>Admin</span>
      </p>

      <div class="panel panel-body">
        <header class="page-header">
          <h1>Anmelden</h1>
          <p>Mit dem Admin-Konto anmelden.</p>
        </header>

        <p id="validation" class="banner error" role="alert" hidden>
          Falsches Passwort oder E-Mail Adresse
        </p>

        <!-- post so a failed script never puts the password in the URL -->
        <form method="post" class="fields">
          <div>
            <label for="email" class="label">
              E-Mail
            </label>
            <input
              type="email"
              name="email"
              id="email"
              class="input"
              autocomplete="username"
              required
            />
          </div>

          <div>
            <label for="password" class="label">
              Passwort
            </label>
            <div class="password">
              <input
                type="password"
                name="password"
                id="password"
                class="input"
                autocomplete="current-password"
                required
              />
              <button
                type="button"
                id="toggle"
                class="icon-button toggle"
                aria-label="Passwort anzeigen"
                aria-pressed="false"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="show"
                >
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>

                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="hide"
                >
                  <path d="M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-2.2 3.2M6.6 6.6C3.7 8.4 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6M3 3l18 18M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" id="submit" class="button">
            Anmelden
          </button>
        </form>
      </div>
    </main>
  </body>
</html>

<style>
  .signin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 24rem;
    min-height: 100dvh;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .brand {
    text-align: center;
  }

  .fields {
    display: grid;
    gap: 1rem;
  }

  .password {
    position: relative;

    & .input {
      padding-right: 3rem;
    }
  }

  .toggle {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    transform: translateY(-50%);

    &[aria-pressed='false'] .hide,
    &[aria-pressed='true'] .show {
      display: none;
    }
  }

  .button {
    margin-top: 0.5rem;
  }

  .banner[hidden] {
    display: none;
  }
</style>

<script>
  import { FirebaseClient } from '@services/firebaseClient';

  const form = document.querySelector('form');
  const password = document.querySelector<HTMLInputElement>('#password');
  const toggle = document.getElementById('toggle');
  const submit = document.querySelector<HTMLButtonElement>('#submit');
  const validation = document.getElementById('validation');

  const setLoading = (loading: boolean) => {
    if (!submit) return;

    submit.disabled = loading;
    submit.textContent = loading ? 'Anmelden …' : 'Anmelden';
  };

  form?.addEventListener('input', () => {
    if (validation) validation.hidden = true;
  });

  toggle?.addEventListener('click', () => {
    if (!password) return;

    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.setAttribute('aria-pressed', String(show));
  });

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    setLoading(true);

    const formData = new FormData(form);

    try {
      const idToken = await FirebaseClient.signIn(
        String(formData.get('email')),
        String(formData.get('password')),
      );

      const response = await fetch('/api/auth/signin', {
        method: 'POST',
        headers: { Authorization: `Bearer ${idToken}` },
      });

      // The server keeps the session now, the client sign-in is not needed
      await FirebaseClient.signOut();

      if (!response.ok) throw new Error(await response.text());

      window.location.assign('/admin');
    } catch {
      setLoading(false);
      if (validation) validation.hidden = false;
    }
  });
</script>
