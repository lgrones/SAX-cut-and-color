{
  "name": "sax-cut-and-color",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "firebase:emulators": "firebase emulators:start --only firestore",
    "firebase:export": "firebase emulators:export exported-dev-data",
    "firebase:kill": "npx kill-port 4000 4400 4500 6100 8080 9000 9099",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "astro sync && concurrently \"pnpm lint:check\" \"pnpm lint:styles\" \"pnpm format:check\" \"pnpm astro:check\" -p name -n \"Lint,Styles,Format,Astro\" -c \"magenta,cyan,yellow,blue\"",
    "lint:check": "oxlint",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\"",
    "format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
    "format:fix": "oxfmt && prettier --write \"**/*.astro\"",
    "astro:check": "astro check",
    "astro": "astro",
    "release": "pnpm build && pnpm release:server && pnpm release:hosting",
    "release:server": "gcloud run deploy web --source . --project sax-cut-and-color --region europe-west1 --allow-unauthenticated --set-secrets PROJECT_ID=PROJECT_ID:latest,CLIENT_EMAIL=CLIENT_EMAIL:latest,PRIVATE_KEY=PRIVATE_KEY:latest",
    "release:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/preact": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "astro-seo-metadata": "^0.6.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "preact": "^11.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
