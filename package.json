{
  "name": "sax-cut-and-color",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:mobile": "./scripts/mobileDev.sh",
    "firebase:emulators": "firebase emulators:start --only firestore,auth,storage --import firebase-export-1714228570097AZJB4e --export-on-exit",
    "firebase:kill": "npx kill-port 4000 4400 4500 6100 8080 9000 9099 9199",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "astro sync && concurrently \"pnpm lint:check\" \"pnpm lint:styles\" \"pnpm format:check\" \"pnpm astro:check\" -p name -n \"Lint,Styles,Format,Astro\" -c \"magenta,cyan,yellow,blue\"",
    "lint:check": "oxlint",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\"",
    "format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
    "format:fix": "oxfmt && prettier --write \"**/*.astro\"",
    "astro:check": "astro check",
    "astro": "astro",
    "release": "pnpm build && pnpm release:rules && pnpm release:server && pnpm release:hosting",
    "release:rules": "firebase deploy --only firestore:rules,storage",
    "release:server": "gcloud run deploy web --source . --project sax-cut-and-color --region europe-west1 --allow-unauthenticated --service-account web-runtime@sax-cut-and-color.iam.gserviceaccount.com --clear-secrets",
    "release:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@mantine/form": "^9.7.2",
    "@sentry/astro": "^11.8.0",
    "astro": "^7.3.8",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
